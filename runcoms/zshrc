# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Customize to your needs...
export PATH=/usr/local/opt/curl/bin:/usr/local/opt/openssl@1.1/bin:$HOME/bin:/usr/local/bin:$PATH
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

export LDFLAGS="-L/usr/local/opt/openssl@1.1/lib"
export CPPFLAGS="-I/usr/local/opt/openssl@1.1/include"




# echo "Binding keys...."
# bindkey "\e\e[D" emacs-backward-word
# bindkey "\e\e[C" emacs-forward-word
# bindkey "\x0f" beginning-of-line
# bindkey "\x1f" end-of-line
# bindkey "\x9f" backward-kill-line
# bindkey "\x90" backward-kill-word

. $HOME/.asdf/asdf.sh

# append completions to fpath
fpath=(${ASDF_DIR}/completions $fpath)
# initialise completions with ZSH's compinit
autoload -Uz compinit
compinit

#function inspect SSL certs through commandline
function seecert () {
  nslookup $1
  (openssl s_client -showcerts -servername $1 -connect $1:443 <<< "Q" | openssl x509 -text | grep -iA2 "Validity")
}
